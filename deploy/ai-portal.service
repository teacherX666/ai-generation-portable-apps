# systemd unit - AI Generation Portal
# Install: cp deploy/ai-portal.service /etc/systemd/system/ && systemctl daemon-reload
[Unit]
Description=AI Generation Portal (portal + sub-apps)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/ai-portal/portal
ExecStart=/opt/ai-portal/.venv/bin/python3 app.py
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=30

# TLS is terminated by Caddy; Portal runs plain HTTP.
Environment=PORTAL_PORT=9090
Environment=PORTAL_HTTP_ONLY=1
Environment=ALLOWED_ORIGINS=https://easyq.cn
Environment=SEEDANCE_ENGINE=fastapi
Environment=NANO_BANANA_ENGINE=fastapi
Environment=DREAMINA_ENGINE=fastapi
Environment=VOLCENGINE_PORTRAIT_ENGINE=fastapi
Environment=INFINITE_CANVAS_ENGINE=fastapi
Environment=RAG_ASSISTANT_ENGINE=fastapi
# The model-machine gateway is part of the deployed code contract.
Environment=AIPORT_BASE_URL=http://UT-20210713KMWD.local:8801
Environment=HOME=/root
Environment=PATH=/opt/ai-portal/.venv/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target