# Deployment-specific local AI Port settings.
# Copy to config/local_ai.env on each machine and keep it out of code sync.

# On the website/server machine, point at the model machine's AI Port:
AIPORT_BASE_URL=http://UT-20210713KMWD.local:8801

# Only used on the model machine by local_ai_backends_watchdog.ps1.
# Set to 0.0.0.0 when another LAN server needs to reach AI Port.
LOCAL_AI_LISTEN=127.0.0.1
