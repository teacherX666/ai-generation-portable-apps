      "hint": "Free local MiniMax H3.",
      "defaults": {
        "model": "minimax_h3_all_reference",
        "duration": 8,
        "resolution": "720p",
        "ratio": "16:9",
        "repeat_count": 1,
        "concurrency": 1,
        "poll_interval": 5,
        "timeout": 7200,
        "vary_seed": true
